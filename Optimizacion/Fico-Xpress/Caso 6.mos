model Horario
uses "mmxprs"

declarations
	n: integer
end-declarations

initializations from "caso 6.txt"
	n
end-initializations

declarations
	D=1..n
	e: array(D) of integer
	d: array(D,D) of integer
	x: array(D) of mpvar
end-declarations

initializations from "caso 6.txt"
	e d
end-initializations

z:=sum(i in D) x(i)
forall(i in D) sum(j in D) d(i,j)*x(j) >= e(i)
forall(i in D) x(i) is_integer
minimize(z)

writeln("Numero minimo de empleados a contratar ", getobjval)
forall(i in D) 
	writeln(getsol(x(i)), " empleados empiezan a trabajar el dia ", i)
	
declarations
	Dias: array(D) of string
end-declarations

initializations from "caso 6.txt"
	Dias
end-initializations

forall(i in D)
	writeln("El ", Dias(i)," hay ", getsol(sum(j in D) d(i,j)*x(j))," empleados disponibles")
end-model
