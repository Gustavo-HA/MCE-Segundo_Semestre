
model Transporte
uses "mmxprs"; !gain access to the Xpress-Optimizer solver

declarations
	m:integer !cantidad de plantas
	n:integer !cantidad de ciudades
end-declarations

initializations from "caso 1.txt"   !lectura del txt del tamaño que tendrán los conjuntos
	m n
end-initializations 

declarations
	!Conjuntos
	P=1..m
	C=1..n
	!Parámetros
	b:array(P) of real   !capacidad productora de plantas
	d:array(C) of real   !demanda de cada centro de distribución (CD) en las ciudades
	c:array(P,C) of real !costos de envío de plantas a CD en ciudades
	!Variables
	x:array(P,C) of mpvar !cantidad de galones a enviar
end-declarations

initializations from "caso 1.txt" !lectura del txt de los parámetros
	b d c
end-initializations 

!Modelo
z:=sum(i in P, j in C) c(i,j)*x(i,j)   !Función objetivo
forall(i in P) sum(j in C) x(i,j) <= b(i) !Restricción de capacidad
forall(j in C) sum(i in P) x(i,j) >= d(j) !Restricción de demanda
!forall(i in P, j in C) x(i,j) is_integer !Variables enteras
minimize(z)

writeln ("Costo:", 1000*getobjval)

forall(i in P, j in C | getsol(x(i,j))>0)  !Aquí se imprime sólo cuando se envían galones
	writeln ("Enviar ", 1000*getsol(x(i,j)), " galones de la planta ", i, " al centro de distribucion en ", j)

end-model
