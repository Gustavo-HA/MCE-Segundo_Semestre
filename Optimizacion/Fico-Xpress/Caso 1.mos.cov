           
           model Transporte
           uses "mmxprs"; !gain access to the Xpress-Optimizer solver
           
           declarations
           	m:integer !cantidad de plantas
           	n:integer !cantidad de ciudades
           end-declarations
           
         1 initializations from "caso 1.txt"   !lectura del txt del tama·o que tendr·n los conjuntos
           	m n
           end-initializations 
           
           declarations
           	!Conjuntos
         1 	P=1..m
         1 	C=1..n
           	!Par·metros
         1 	b:array(P) of real   !capacidad productora de plantas
         1 	d:array(C) of real   !demanda de cada centro de distribuci·n (CD) en las ciudades
         1 	c:array(P,C) of real !costos de env·o de plantas a CD en ciudades
           	!Variables
         1 	x:array(P,C) of mpvar !cantidad de galones a enviar
           end-declarations
           
         1 initializations from "caso 1.txt" !lectura del txt de los par·metros
           	b d c
           end-initializations 
           
           !Modelo
         1 z:=sum(i in P, j in C) c(i,j)*x(i,j)   !Funci·n objetivo
         1 forall(i in P) sum(j in C) x(i,j) <= b(i) !Restricci·n de capacidad
         1 forall(j in C) sum(i in P) x(i,j) >= d(j) !Restricci·n de demanda
           !forall(i in P, j in C) x(i,j) is_integer !Variables enteras
         1 minimize(z)
           
         1 writeln ("Costo:", 1000*getobjval)
           
         1 forall(i in P, j in C | getsol(x(i,j))>0)  !Aqu· se imprime s·lo cuando se env·an galones
        14 	writeln ("Enviar ", 1000*getsol(x(i,j)), " galones de la planta ", i, " al centro de distribucion en ", j)
           
         1 end-model
