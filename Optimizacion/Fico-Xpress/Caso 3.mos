model ModelName
uses "mmxprs"; 
declarations
	C,K: set of integer
end-declarations
initializations from 'caso 3.txt'
	C K
end-initializations

declarations
	p: array(C) of integer !Peso máximo en toneladas del compartimiento i
	v: array(C) of integer !Volumen en metros cúbicos  en el compartimiento i
	pe: array(K) of integer !Toneladas disponibles de la carga j
	vo: array(K) of integer !Volumen (m3/ton) de la carga j
	B: array(K) of integer !Beneficio ($/ton)
	x: array(C,K) of mpvar !Toneladas a trnsportar de la carga j al compartimiento i
end-declarations

initializations from 'caso 3.txt'
 p v pe vo B 
end-initializations

z:=sum(i in C,j in K) B(j)*x(i,j) ! Función objetivo

!Restricciones
forall (i in C) sum(j in K) x(i,j)<=p(i) !No se debe exceder la capacidad en toneladas de los compartimentos
forall (i in C) sum(j in K) vo(j)*x(i,j)<=v(i) !No se debe exceder la capacidad en volumen de los compartimentos
forall (j in K) sum(i in C) x(i,j)<=pe(j) !No se pueden enviar más tonelada de las disponibles
forall(i in 1..getsize(C)-1) (sum(j in K) x(i,j)/p(i))= (sum(j in K) x(i+1,j)/p(i+1)) !Las cargas deben estar balanceadas

maximize(z)

writeln("El beneficio maximo es:",getobjval)
forall(i in C, j in K | getsol(x(i,j))>0) 
writeln("Enviar ", getsol (x(i,j)), " de la carga ", j, "  al compartimiento ", i)


end-model


