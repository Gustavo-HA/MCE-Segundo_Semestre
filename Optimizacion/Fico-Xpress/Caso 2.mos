model Produccion
uses "mmxprs"

declarations
	m: integer 
end-declarations

initializations from "caso 2.txt"
	m
end-initializations

declarations
	!Conjuntos
	M=1..m !Meses
	!Parámetros
	d: array(M)of integer !demanda
	q: integer !capacidad
	qe: integer !capacidad extra
	c: real !costo
	ce: real !costo extra
	a: integer !toneladas en inventario
	ca: real   !costo por almacenar
	Meses: array (M) of string  !Ayuda a imprimir los meses con letra
	!Variables de decisión
	x: array (M) of mpvar !toneladas
	y: array (M) of mpvar !toneladas extra
	s: array ({0}+M) of mpvar  !toneladas almacenadas
	!NOTA: operador + cuando se usa con conjuntos es la unión: en este caso unión de conjuntos {0} Unión M para manejar la variable del inventario inicial

end-declarations

initializations from "caso 2.txt"
	d q qe c ce a ca Meses
end-initializations 

z:= sum(i in M) (c*x(i)+ce*y(i)+ca*s(i))!costo total
forall(i in M) x(i)<=q !capacidad
forall(i in M) y(i)<=qe !capacidad extra
forall (i in M) s(i-1)+ x(i) + y(i)= d(i)+ s(i) !inventario y producción
s(0)=a !inventario inicial
minimize(z)

writeln("El costo minimo es: ", getobjval)
forall(i in M) do
	writeln("En el mes: ", i)
	writeln("    Producir ", getsol(x(i)), " toneladas")
	writeln("    Producir extra ", getsol(y(i)), " toneladas")
	writeln("    Almacenar ", getsol(s(i)), " toneladas")
end-do

!Aquí se imprime de otra manera, con letra los meses
forall(i in M) do
	writeln("Mes: ", Meses(i))
	writeln("    Producir ", getsol(x(i)), " toneladas")
	writeln("    Producir extra ", getsol(y(i)), " toneladas")
	writeln("    Almacenar ", getsol(s(i)), " toneladas")
end-do

end-model
