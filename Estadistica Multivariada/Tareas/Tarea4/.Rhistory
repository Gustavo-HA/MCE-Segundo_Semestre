pca_factorial <- function(R,lambdas,v_propios,m, type = "corr"){
lambda <- lambdas[1:m]
vec <- v_propios[,1:m]
if (type == "corr"){
n <- nrow(R)
}
else{
n <- sum(diag(R))
}
for (i in 1:m){
vec[,i] <- sqrt(lambda[i]) * vec[,i]
}
LL <- vec %*% t(vec)
psi <- diag(R - LL)
comunalidades <- rowSums(vec^2)
varianza_explicada <- (vec^2)*100
var_per_factor <- lambda / n * 100
var_total_acumulado <- cumsum(var_per_factor)
output <- list(
L = vec,
psi = diag(psi),
comm = comunalidades,
var_ex = varianza_explicada,
var_factor = var_per_factor,
var_factor_acum = var_total_acumulado
)
return(output)
}
R <- matrix(c(
1, 0.69, 0.28, 0.35,
0.69, 1, 0.255, 0.195,
0.28, 0.255, 1, 0.61,
0.35, 0.195, 0.61, 1
), nrow = 4, byrow = TRUE)
eig <- eigen(R)
lambdas <- eig$values
v_propios <- eig$vectors
pca_factorial <- function(R,lambdas,v_propios,m, type = "corr"){
lambda <- lambdas[1:m]
vec <- v_propios[,1:m]
if (type == "corr"){
n <- nrow(R)
}
else{
n <- sum(diag(R))
}
for (i in 1:m){
vec[,i] <- sqrt(lambda[i]) * vec[,i]
}
LL <- vec %*% t(vec)
psi <- diag(R - LL)
comunalidades <- rowSums(vec^2)
varianza_explicada <- (vec^2)*100
var_per_factor <- lambda / n * 100
var_total_acumulado <- cumsum(var_per_factor)
output <- list(
L = vec,
psi = diag(psi),
comm = comunalidades,
var_ex = varianza_explicada,
var_factor = var_per_factor,
var_factor_acum = var_total_acumulado
)
return(output)
}
