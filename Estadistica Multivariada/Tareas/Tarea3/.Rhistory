# Load necessary libraries
library(ggplot2)
library(tidyr)
library(dplyr)
# Reshape the data to long format (keeping 'Class' separate)
vinos_long <- vinos %>%
pivot_longer(
cols = -Class,            # Exclude the 'Class' variable
names_to = "Variable",    # New column to hold variable names
values_to = "Value"       # New column to hold corresponding values
)
View(vinos_long)
View(vinos_long)
# Create density plots for all variables, colored by wine class
ggplot(vinos_long, aes(x = Value, fill = factor(Class))) +
geom_density(alpha = 0.4) +                # Transparency for overlapping densities
facet_wrap(~ Variable, scales = "free") +  # Separate panel for each variable with independent scales
labs(
title = "Density Plots for All Wine Variables by Wine Class",
x = "Value",
y = "Density",
fill = "Wine Class"
) +
theme_minimal(base_size = 15) +
theme(plot.title = element_text(hjust = 0.5))
vinos$Class <- as.factor(vinos$Class)
library(MASS)
?select
vinos <- read.csv("./data/wine.data", header = FALSE)
names(vinos) <- c("Class","Alcohol","Malic", "Ash", "Alcal", "Mg",
"Phenol","Flav","Nonf","Proan","Color","Hue","Abs","Proline")
unique(vinos$Class)
vinos$Class <- as.factor(vinos$Class)
library(MASS)
## Inciso a)
lda_modelo <- lda(Class ~ ., data = vinos)
str(vinos)
lda_modelo
## Inciso b)
predichos <- predict(lda_modelo)
View(predichos)
df_plot <- data.frame(
LD1 = predichos$x[,1],
LD2 = predichos$x[,2],
Class = vinos$Class
)
library(ggplot2)
ggplot(data=df_plot, aes(x = LD1, y = LD2, color=Class)) +
geom_point(size=3)
ggplot(data=df_plot, aes(x = LD1, y = LD2, color=Class, shape=Class)) +
geom_point(size=3)
View(vinos)
# División entrenamiento/prueba (80% - 20%, por ejemplo)
set.seed(123)  # Semilla para reproducibilidad
train_index <- sample(seq_len(nrow(vinos)), size = 0.8 * nrow(vinos))
train_data <- vinos[train_index, ]
test_data  <- vinos[-train_index, ]
train_data <- vinos[train_index, ]
test_data  <- vinos[-train_index, ]
# Ajustar el modelo LDA
modelo_lda <- lda(Class ~ ., data = train_data)
# Ver un resumen (proporciones de trazas, medias de grupos, etc.)
modelo_lda
# Predicción sobre el conjunto de prueba
predicciones <- predict(modelo_lda, newdata = test_data)
# Matriz de confusión
tabla_conf <- table(Predicho = predicciones$class, Real = test_data$Class)
tabla_conf
# Exactitud (accuracy)
exactitud <- mean(predicciones$class == test_data$Class)
exactitud
## Inciso c)
### Validación cruzada
