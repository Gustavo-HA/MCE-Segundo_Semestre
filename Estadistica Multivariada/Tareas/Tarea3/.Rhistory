- Determine los intervalos de confianza simúltaneos e individuales para un nivel de significancia de $\alpha$ = 0.05.
covarianza <- cov(df)
n <- nrow(df)
p <- ncol(df)
alfa <- 0.05
critico <- (n-1)*p/(n-p)qf(alfa, p, n-p, lower.tail = FALSE)
critico <- (n-1)*p/(n-p)*qf(alfa, p, n-p, lower.tail = FALSE)
s <- diag(covarianza)
simultaneo_inferior <- x_bar - sqrt(critico*s/n)
simultaneo_superior <- x_bar + sqrt(critico*s/n)
x_bar <- colMeans(df)
simultaneo_inferior <- x_bar - sqrt(critico*s/n)
simultaneo_superior <- x_bar + sqrt(critico*s/n)
